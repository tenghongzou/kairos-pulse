# Pulse 遠端升級的特權輔助程式（crates/kairos-proto/REMOTE.md 第 4.4.1～4.5 節）
#
# 由 pulse-upgrade.path 在 /var/lib/pulse/upgrade/request.json 出現時啟動，以 root 執行「目前已安裝的」
# /opt/pulse/pulse：把請求與暫存的發佈包複製到 /var/lib/pulse-upgrade/<upgrade_id>/（root 專用）、以本機的
# 信任錨（pulse.toml 的 [upgrade] allowed_signers）重新驗證、預檢新版、替換（tar：pulse.prev＋改名；
# deb：dpkg -i；rpm：rpm -U）、重新啟動 pulse.service、健康確認，失敗時自動回滾；結果寫到
# /var/lib/pulse/upgrade/result.json，替換後的 Pulse 讀取後回報給 Kairos。紀錄：journalctl -u pulse-upgrade
# 與 /var/lib/pulse-upgrade/<upgrade_id>/upgrade.log（pulse diag 收集）。
#
# 不要手動啟動；修改請用 systemctl edit pulse-upgrade 建立 drop-in。

[Unit]
Description=Pulse remote upgrade helper
Documentation=file:/opt/pulse/INSTALL.md
ConditionPathExists=/var/lib/pulse/upgrade/request.json

[Service]
Type=oneshot
ExecStart=/opt/pulse/pulse upgrade apply --request /var/lib/pulse/upgrade/request.json
# 健康確認最長 3600 秒，回滾後再確認一次，另有套件資料庫被鎖住時最多 10 分鐘的重試
TimeoutStartSec=2h30min
# root 專用的工作目錄 /var/lib/pulse-upgrade（0700）
StateDirectory=pulse-upgrade
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
# 不連網路：要用的檔案都已由 Pulse 暫存（REMOTE.md 第 4.4.1 節）
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
UMask=0022
