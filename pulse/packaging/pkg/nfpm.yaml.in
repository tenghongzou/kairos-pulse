# Pulse 的 deb／rpm（nfpm；packaging/build-release-common.sh 以 sed 代入 @…@ 後在建置容器內執行）。
# 版面與發佈包（tar.gz）相同：/opt/pulse；另外放 systemd unit 與 /usr/bin/pulse 的符號連結。
# logs/、buffer/、identity/、agent.id 由 postinstall 建立（不屬於套件，升級時不動）。
name: pulse
arch: "@ARCH@"
platform: linux
version: "@VERSION@"
version_schema: semver
release: "1"
section: admin
priority: optional
maintainer: "Kairos-Pulse release <release@kairos-pulse>"
vendor: Kairos-Pulse
homepage: https://kairos-pulse.invalid/
license: Proprietary
description: |-
  Pulse monitoring agent: reports system information to a Kairos server
  over mTLS; enrolls with `pulse enroll --install-string`.
mtime: "@MTIME@"
disable_globbing: true
contents:
  - dst: /opt/pulse
    type: dir
    file_info: {mode: 0751, owner: root, group: pulse}
  - src: "@STAGE@/pulse"
    dst: /opt/pulse/pulse
    file_info: {mode: 0755, owner: root, group: root}
  - src: "@PKGDIR@/pulse.default.toml"
    dst: /opt/pulse/pulse.toml
    type: config|noreplace
    file_info: {mode: 0640, owner: root, group: pulse}
  - src: "@STAGE@/pulse.service"
    dst: /usr/lib/systemd/system/pulse.service
    file_info: {mode: 0644, owner: root, group: root}
  # 遠端升級的輔助程式（crates/kairos-proto/REMOTE.md 第 4.4.1 節）：postinstall 啟用 pulse-upgrade.path
  - src: "@STAGE@/pulse-upgrade.path"
    dst: /usr/lib/systemd/system/pulse-upgrade.path
    file_info: {mode: 0644, owner: root, group: root}
  - src: "@STAGE@/pulse-upgrade.service"
    dst: /usr/lib/systemd/system/pulse-upgrade.service
    file_info: {mode: 0644, owner: root, group: root}
  - src: /opt/pulse/pulse
    dst: /usr/bin/pulse
    type: symlink
    file_info: {mode: 0777, owner: root, group: root}
@DOCS@
scripts:
  preinstall: "@PKGDIR@/preinstall.sh"
  postinstall: "@PKGDIR@/postinstall.sh"
  preremove: "@PKGDIR@/preremove.sh"
  postremove: "@PKGDIR@/postremove.sh"
# 遠端升級的輔助程式解開新版套件做預檢（crates/kairos-proto/REMOTE.md 第 17.2 節第 13 項）：rpm 以
# rpm2cpio（rpm 套件內附）＋cpio，Rocky／RHEL 9 的最小安裝沒有 cpio（tests/systemd 實測）。deb 的 dpkg-deb
# 屬於 dpkg，不需另外宣告
overrides:
  rpm:
    depends:
      - cpio
deb:
  compression: gzip
rpm:
  # 固定的建置主機名稱（預設為容器的 hostname，每次不同，會讓 rpm 無法重現）
  buildhost: kairos-pulse-build
  group: System Environment/Base
  compression: gzip
