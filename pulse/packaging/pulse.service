# Pulse 系統層級 systemd unit 範本（單一實例，/opt/pulse）
#
# 安裝（完整步驟見 INSTALL.md）：
#   install -m 644 pulse.service /etc/systemd/system/pulse.service
#   systemctl daemon-reload && systemctl enable --now pulse
#
# 前提：
#   - 專用使用者 pulse（無登入 shell），程式與設定在 /opt/pulse
#   - /opt/pulse/agent.id 已事先以 `pulse --print-agent-id` 產生（ProtectSystem=strict
#     下 /opt/pulse 本身唯讀，服務無法自行建立 agent.id）
#   - /opt/pulse/logs 已建立且屬於 pulse（可寫；不存在時 unit 會以 226/NAMESPACE 啟動失敗）
#   - /opt/pulse/buffer 已建立且屬於 pulse（本機緩衝，可寫；路徑前的 - 表示不存在時不影響啟動，
#     但 Pulse 無法建立緩衝，會記 ERROR 並改為 at-most-once）
#   - 以 pulse enroll 註冊時：/opt/pulse/identity 已建立且屬於 pulse、0700（私鑰、憑證與
#     enrollment.json；服務在背景輪詢待核准的申請、過期續簽與自動更新憑證時寫入）
#
# 同一台主機要跑多個實例時，每個實例複製一份 unit（例如 pulse-2.service 對應 /opt/pulse-2），
# 只改 WorkingDirectory= 與 ReadWritePaths= 兩行（ReadWritePaths= 的三個路徑都要改）；
# 執行檔仍用 /opt/pulse/pulse。
# 詳見 INSTALL.md 第 9 節。
#
# 修改請用 `systemctl edit pulse` 建立 drop-in，不要直接改這個檔案。

[Unit]
Description=Pulse monitoring agent
Documentation=file:/opt/pulse/INSTALL.md file:/opt/pulse/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 只用 sd_notify 更新狀態文字（systemctl status 的「Status:」：連線中／已註冊／重新連線中／
# 無法連線：伺服器憑證<原因>／無法註冊：<錯誤碼>），不送 READY=1，因此維持 Type=simple；
# 只接受主程序送來的通知
NotifyAccess=main
User=pulse
Group=pulse
# pulse.toml、agent.id、憑證與 logs/ 都以工作目錄解析
WorkingDirectory=/opt/pulse
ExecStart=/opt/pulse/pulse

# 日誌只保留 logs/pulse-YYYY-MM-DD.log 一份（Pulse 的日誌寫到 stdout 與 logs/）。0.6 重新評估後維持 null：
# 交給 SIEM 時改用 pulse.toml 的 [log.syslog]（RFC 5424 直接外送）或 log.format = "json" 由收集器讀檔；
# 要讓 journald 收集 stdout 時以 systemctl edit pulse 設定 StandardOutput=journal（INSTALL.md 7.1）。
# stderr 仍進 journal：設定錯誤、日誌初始化失敗、panic 等「日誌檔還沒開好就發生」的
# 錯誤都寫在 stderr，`journalctl -u pulse` 仍看得到；憑證錯誤等使 Pulse 結束的原因也另寫一行。需要人工處理的持續性錯誤（憑證被撤銷、
# auth_failed、狀態表已滿、本機憑證過期等）也會以 err 等級另寫一行到 stderr（同一原因每
# 10 分鐘最多一行），`journalctl -u pulse -p err` 可篩選。理由見 INSTALL.md。
StandardOutput=null
StandardError=journal

# 正常結束：送出 close_notify 後約 1 秒內結束；再送一次訊號會以 130 強制結束
KillSignal=SIGINT
TimeoutStopSec=10
# Pulse 本身會無限重連；這裡處理取樣任務異常等內部錯誤（結束代碼 1）。
# 重試也不會成功的錯誤不重新啟動，服務停在 failed，修正後執行 systemctl restart pulse：
#   2 用法錯誤（ExecStart 的命令列參數）
#   3 設定錯誤（pulse.toml、PULSE__* 環境變數的語法、型別、範圍錯誤等）
#   4 憑證錯誤（ca_cert、客戶端憑證或私鑰無法讀取、格式錯誤、不成對，SAN 與 agent_id 不符，
#     agent.id 無法讀取或內容不合法）
Restart=always
RestartSec=10
RestartPreventExitStatus=2 3 4

# 本機狀態檔 /var/lib/pulse/status.json（pulse status 讀取，所有人可讀）：systemd 在啟動前建立
# /var/lib/pulse（擁有者 pulse、0755），並讓它在 ProtectSystem=strict 下可寫。
# 多實例的 unit 改為 StateDirectory=pulse/N，並在 pulse.toml 設定 [status] file（INSTALL.md 第 9 節）。
# 沒有這兩行的舊 unit：Pulse 改寫 logs/status.json 並記 WARN（PLS-E8204），服務照常執行
StateDirectory=pulse
StateDirectoryMode=0755

# 主機資產的系統序號（0.8.0，METRICS.md 第 4.5 節、第 17 節 D4）：/sys/class/dmi/id/product_serial
# 只有 root 能讀，而 Pulse 以 pulse 使用者、沒有任何 capability 執行。啟動前以 root 執行一次複製
# （前綴 + 不受下方的沙箱與 User= 限制；前綴 - 表示失敗不影響啟動，例如沒有 DMI 的虛擬機），
# 放到 /run/pulse-hw/product_serial，Pulse 讀這個檔案。0.13.0 起（安全稽核 A2）：目的地改為
# root 擁有的目錄（root:pulse 0750，檔案 root:pulse 0440）——root 不在服務帳號可寫的目錄中寫入，
# 服務帳號無法事先在目的地放符號連結；-T 讓 install 一律把目的地當成檔案。舊版 unit 複製到
# /run/pulse/product_serial，Pulse 仍會讀它（新版執行檔搭配舊 unit 時）。
# 讀不到時 Pulse 不送序號並記一次 PLS-I8009。不想送序號時在 pulse.toml 設定
# [inventory] hardware_serials = false（這幾行可保留）。多實例共用同一個 /run/pulse-hw。
# RuntimeDirectory=pulse（/run/pulse，擁有者 pulse）保留給舊版執行檔與日後的執行期檔案；多實例共用，
# 因此 RuntimeDirectoryPreserve=yes（停止其中一個實例時不刪除）
RuntimeDirectory=pulse
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStartPre=-+/usr/bin/install -d -o root -g pulse -m 0750 /run/pulse-hw
ExecStartPre=-+/usr/bin/install -T -o root -g pulse -m 0440 /sys/class/dmi/id/product_serial /run/pulse-hw/product_serial

# ---- 硬化 -------------------------------------------------------------------
ProtectSystem=strict
ReadWritePaths=/opt/pulse/logs -/opt/pulse/buffer -/opt/pulse/identity
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
# hostname 只在啟動時讀取一次（唯讀），主機改名後 systemctl restart pulse 即可反映
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
