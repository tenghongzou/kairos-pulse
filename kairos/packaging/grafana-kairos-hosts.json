      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(system_filesystem_usage_percent{host_group=~\"$host_group\",hostname=~\"$hostname\"})",
